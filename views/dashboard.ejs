<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/dashboard.css"> <!-- Include the new CSS file -->
    <title>Dashboard</title>
</head>
<body>
    <div class="container">
        <h1>Welcome, <%= user.username %></h1>
        <h2>Your Guilds</h2>
        <ul class="guild-list">
            <% user.guilds.forEach(guild => { %>
                <li>
                    <div class="guild-avatar">
                        <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png" alt="<%= guild.name %> Avatar">
                    </div>
                    <div class="guild-details">
                        <div class="guild-name"><%= guild.name %></div>
                        <a href="/api/invite/<%= guild.id %>" class="btn">Invite</a>
                        <a href="/guild/<%= guild.id %>" class="btn">Manage</a>
                    </div>
                </li>
            <% }) %>
        </ul>
        <a href="/auth/logout" class="btn">Logout</a>
    </div>
</body>
</html>
