<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Discord Bot Dashboard</title>
</head>
<body>
    <h1>Welcome</h1>
    <% if (user) { %>
        <p>Hello, <%= user.username %>!</p>
        <a href="/dashboard">Go to Dashboard</a>
        <a href="/auth/logout">Logout</a>
    <% } else { %>
        <a href="/auth/login">Login with Discord</a>
    <% } %>
</body>
</html>
